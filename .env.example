# ── Browser (Vite) ────────────────────────────────────────────────────────────
# These are compiled into the client bundle and are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only — set these in the Vercel dashboard, NOT in .env ──────────────
# .env is committed to this repo, so anything secret placed there is published.
# Vercel > Project > Settings > Environment Variables.

# Resend (https://resend.com) — API key and the verified sending address.
RESEND_API_KEY=
NOTIFY_FROM="Curtain Ideas Manufacturing <manufacturing@notifications.curtainideas.com.au>"

# Recipients. Comma-separated for more than one.
NOTIFY_ORDERS=
NOTIFY_PICKUP=
NOTIFY_STOCK=

# Shared secret sent by the Supabase database webhooks as `x-webhook-secret`.
NOTIFY_WEBHOOK_SECRET=

# Vercel Cron sends this automatically as `Authorization: Bearer <value>`.
CRON_SECRET=

# Supabase, for the endpoints that query the database. These are NOT inherited
# from the .env above — Vite reads that file at build time for the browser
# bundle, but serverless functions read process.env at runtime, which only
# contains what is set on the Vercel project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # falls back to VITE_SUPABASE_ANON_KEY if that is set here too

# Optional.
APP_URL=                       # link target for the button in each email
NOTIFY_TIMEZONE=Australia/Sydney
NOTIFY_DUE_DAYS=7
